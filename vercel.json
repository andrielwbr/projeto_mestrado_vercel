{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "static/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/registrar_treino", "dest": "/api/index.py" },
    { "src": "/registrar_feedback", "dest": "/api/index.py" },
    { "src": "/historico_grafico", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/static/index.html" }
  ]
}